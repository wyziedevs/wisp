{#story "Primary"}<Button>Save</Button>{/story}

{#story "Secondary"}<Button variant="secondary">Cancel</Button>{/story}

{#story "Ghost"}<Button variant="ghost" size="sm">More</Button>{/story}

{#story "Danger"}<Button variant="danger" size="lg">Delete</Button>{/story}

{#story "Link"}<Button href="/" variant="secondary">Home</Button>{/story}

{#story "Disabled"}<Button disabled>Saving</Button>{/story}
