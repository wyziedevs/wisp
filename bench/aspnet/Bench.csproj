<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- The ASP.NET Core side of bench/: the same fortunes, page, json and
       plaintext endpoints as bench/app, written the way the docs and
       templates do. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <!-- The static file every server serves, from bench/static, at /static/app.js. -->
  <ItemGroup>
    <Content Include="../static/app.js" Link="wwwroot/static/app.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
