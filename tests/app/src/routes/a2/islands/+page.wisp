<h1>Islands</h1>
<div id="now"><Chart label="idle" client:idle /></div>
<div id="wide"><Chart label="wide" client:media="(min-width: 1px)" /></div>
<div id="touch"><Stepper client:interaction /></div>
<div id="never"><Chart label="never" client:none /></div>
<div id="far" style="margin-top: 3000px"><Tally client:visible /></div>
