{
  "name": "wisp",
  "displayName": "Wisp",
  "description": "Wisp .wisp templates: highlighting, problems as you type, hovers, go to definition, completion, snippets, format on save.",
  "version": "0.1.0",
  "publisher": "wisp",
  "license": "MIT",
  "author": { "name": "Wyzie LLC", "url": "https://wyzie.io" },
  "repository": "https://github.com/wyziedevs/wisp",
  "engines": { "vscode": "^1.82.0" },
  "icon": "icons/icon.png",
  "homepage": "https://github.com/wyziedevs/wisp/tree/main/editors/vscode",
  "categories": ["Programming Languages", "Snippets", "Formatters"],
  "keywords": ["wisp", "rust", "web framework", "template", "wisp-lang"],
  "activationEvents": ["onLanguage:wisp"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      { "command": "wisp.restart", "title": "Restart server", "category": "Wisp" }
    ],
    "snippets": [{ "language": "wisp", "path": "./snippets.json" }],
    "configurationDefaults": {
      "[wisp]": {
        "editor.defaultFormatter": "wisp.wisp",
        "editor.formatOnSave": true
      }
    },
    "languages": [
      {
        "id": "wisp",
        "aliases": ["Wisp"],
        "extensions": [".wisp"],
        "icon": { "light": "./icons/wisp.svg", "dark": "./icons/wisp.svg" },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "wisp",
        "scopeName": "text.html.wisp",
        "path": "./syntaxes/wisp.tmLanguage.json",
        "embeddedLanguages": {
          "source.rust": "rust",
          "source.js": "javascript",
          "source.ts": "typescript",
          "source.css": "css"
        }
      },
      {
        "scopeName": "wisp.holes",
        "path": "./syntaxes/holes.tmLanguage.json",
        "injectTo": ["text.html.wisp"],
        "embeddedLanguages": { "source.rust": "rust", "source.js": "javascript" }
      }
    ],
    "configuration": {
      "title": "Wisp",
      "properties": {
        "wisp.path": {
          "type": "string",
          "default": "wisp",
          "description": "The wisp command, which runs `wisp lsp`."
        }
      }
    }
  },
  "dependencies": { "vscode-languageclient": "^9.0.1" }
}
